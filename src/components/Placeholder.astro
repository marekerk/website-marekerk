---
/**
 * Placeholder for a photo the congregation still has to supply (navy 10 block).
 * <Placeholder label="koffie na de dienst" />  ->  "Foto · koffie na de dienst"
 * Size/placement via class or style, e.g. style="grid-column: span 2; min-height: 200px; padding: 20px".
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  label: string;
}

const { label, class: className, ...rest } = Astro.props;
---
<div class:list={['placeholder', className]} {...rest}><span>Foto · {label}</span></div>
