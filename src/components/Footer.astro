---
import credits from '../assets/photos/credits.json';
import { href } from '../lib/url';
import { AGENDA_WEBCAL_URL, CONTACT, KERKOMROEP_URL, YOUTUBE_URL } from '../lib/links';

export type PhotoKey = keyof typeof credits;

interface Props {
  /** Foto's op deze pagina (sleutels uit credits.json), in de volgorde van de credits-regel. */
  photos?: PhotoKey[];
}

const { photos = [] } = Astro.props;

const names = [
  ...new Set(
    photos.map((key) => {
      const c: { artist: string; credit?: string } = credits[key];
      return c.credit ?? c.artist;
    }),
  ),
];
---
<footer class="site-footer">
  <div class="site-footer-cols">
    <div style="display: flex; flex-direction: column; gap: 12px">
      <div style="display: flex; align-items: center; gap: 10px"><svg aria-hidden="true" width="36" height="36" viewBox="0 0 64 64"><path fill="#FFFFFF" d="M32.2409 8.87475C33.6841 10.8245 33.1624 12.6117 32.7214 13.2616V15.3341H33.2031V17.4052C34.935 18.4777 35.5278 20.3708 35.608 21.1833V30.2016C35.608 32.6382 35.8488 32.6386 36.2096 33.3695C38.7355 33.3695 37.7333 34.6291 37.7733 35.3196C43.5469 38.4882 45.5111 43.8504 45.8318 45.8003H48.1182L48.4789 46.1658L47.8773 46.7747V48.4816H48.5987L47.5167 49.5783V55.3052C47.7972 60.3502 50.7358 62.8957 53.3333 64H10.6667C13.2642 62.8957 16.2028 60.3502 16.4833 55.3052V49.5783L15.4013 48.4816H16.1227V46.7747L15.5211 46.1658L15.8818 45.8003H18.1682C18.4889 43.8504 20.4531 38.4882 26.2267 35.3196C26.2668 34.6291 25.2645 33.3695 27.7904 33.3695C28.1512 32.6386 28.392 32.6382 28.392 30.2016V21.1833C28.4722 20.3708 29.065 18.4777 30.7969 17.4052V15.3341H31.2787V13.2616C30.8376 12.6117 30.3159 10.8245 31.7591 8.87475L32 4L32.2409 8.87475Z"></path></svg><span style="line-height: 1.05"><strong style="display: block; font-size: 20px; color: #FFFFFF">Marekerk</strong><span style="display: block; font-size: 15px; color: #FFFFFF">gemeente</span></span></div>
      <p style="margin: 0">[Adres], Leiden<br>Protestantse Gemeente Leiden</p>
    </div>
    <div class="site-footer-col">
      <span class="label label-goud">Kerkdiensten</span>
      <span>Zondag 10.00 en 17.00</span>
      <a href={YOUTUBE_URL} class="link-licht">YouTube</a>
      <a href={KERKOMROEP_URL} class="link-licht">Kerkomroep</a>
      <a href={AGENDA_WEBCAL_URL} class="link-licht">Agenda abonneren</a>
    </div>
    <div class="site-footer-col">
      <span class="label label-goud">Bezoeken</span>
      <span>Zaterdag 14.00–16.00</span>
      <a href={href('/gebouw/#huren')} class="link-licht">Huren</a>
    </div>
    <div class="site-footer-col">
      <span class="label label-goud">Contact</span>
      <a href={`mailto:${CONTACT.email}`} class="link-licht">{CONTACT.email}</a>
      <a href={CONTACT.telefoonHref} class="link-licht">{CONTACT.telefoon}</a>
      <a href={href('/geven/#contact')} class="link-licht">Alle contactgegevens</a>
      <a href={href('/geven/')} class="btn btn-goud" style="align-self: flex-start; min-height: 40px; padding: 0 16px; font-size: 14px; margin-top: 6px">Geven</a>
    </div>
  </div>
  <div class="site-footer-bottom">
    <span>© Marekerk gemeente Leiden</span>
    {names.length > 0 && <span>Foto's: {names.join(', ')}, via Wikimedia Commons</span>}
  </div>
</footer>
