---
import credits from '../assets/photos/credits.json';
import Emblem from '../assets/emblem.svg';
import Lockup from './Lockup.astro';
import { href } from '../lib/url';
import { AGENDA_WEBCAL_URL, CONTACT, KERKOMROEP_URL, YOUTUBE_URL } from '../lib/links';

export type PhotoKey = keyof typeof credits;

interface Props {
  /** Photos on this page (keys from credits.json), in the order of the credit line. */
  photos?: PhotoKey[];
}

const { photos = [] } = Astro.props;

// Credit line: name (credit or artist) with license; one license for all → once at the end
const photoCredits = photos.map((key) => {
  const c: { artist: string; credit?: string; license: string } = credits[key];
  return { name: c.credit ?? c.artist, license: c.license };
});
const licenses = [...new Set(photoCredits.map((f) => f.license))];
const names = [...new Set(photoCredits.map((f) => (licenses.length > 1 ? `${f.name} (${f.license})` : f.name)))];
const creditLine = names.length
  ? `Foto's: ${names.join(', ')}${licenses.length === 1 ? ` (${licenses[0]})` : ''}, via Wikimedia Commons`
  : '';
---
<footer class="site-footer">
  <Emblem class="site-footer-silhouette" aria-hidden="true" />
  <div class="site-footer-cols">
    <div style="display: flex; flex-direction: column; gap: 12px">
      <Lockup size="footer" />
      <p style="margin: 0">[Adres], Leiden<br>Protestantse Gemeente Leiden</p>
    </div>
    <div class="site-footer-col">
      <span class="label label-gold">Kerkdiensten</span>
      <span>Zondag 10.00 en 17.00</span>
      <a href={YOUTUBE_URL} class="link-light">YouTube</a>
      <a href={KERKOMROEP_URL} class="link-light">Kerkomroep</a>
      <a href={AGENDA_WEBCAL_URL} class="link-light">Agenda abonneren</a>
    </div>
    <div class="site-footer-col">
      <span class="label label-gold">Bezoeken</span>
      <span>Zaterdag 14.00–16.00</span>
      <a href={href('/gebouw/#huren')} class="link-light">Huren</a>
    </div>
    <div class="site-footer-col">
      <span class="label label-gold">Contact</span>
      <a href={`mailto:${CONTACT.email}`} class="link-light">{CONTACT.email}</a>
      <a href={CONTACT.phoneHref} class="link-light">{CONTACT.phone}</a>
      <a href={href('/geven/#contact')} class="link-light">Alle contactgegevens</a>
      <a href={href('/geven/')} class="btn btn-gold" style="align-self: flex-start; min-height: 40px; padding: 0 16px; font-size: 14px; margin-top: 6px">Geven</a>
    </div>
  </div>
  <div class="site-footer-bottom">
    <span>© Marekerk gemeente Leiden</span>
    {creditLine && <span>{creditLine}</span>}
  </div>
</footer>
