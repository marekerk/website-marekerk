---
const baseUrl = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '') || '/';
const buildHref = (path) => {
  const cleanPath = path.replace(/^\/+/, '');
  return baseUrl === '/' ? `/${cleanPath}` : `${baseUrl}/${cleanPath}`;
};

function formatLabel(value) {
  return value
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (char) => char.toUpperCase());
}

const markdownFiles = Object.entries(import.meta.glob('../content/**/*.md', { eager: true }));

const navItems = Object.values(
  markdownFiles.reduce((groups, [filePath]) => {
    const slug = filePath
      .replace(/\\/g, '/')
      .replace(/^.*?content\//, '')
      .replace(/\.md$/, '');

    const segments = slug.split('/').filter(Boolean);

    if (segments.length < 2 || segments[1] === 'index') {
      return groups;
    }

    const [folderName, fileName] = segments;

    if (folderName === 'home') {
      return groups;
    }

    const group = groups[folderName] ?? {
      label: formatLabel(folderName),
      href: buildHref(`${folderName}/page`),
      links: [],
    };

    if (fileName !== 'page') {
      group.links.push({
        label: formatLabel(fileName),
        href: buildHref(`${folderName}/${fileName}`),
      });
    }

    groups[folderName] = group;
    return groups;
  }, {})
)
  .map((group) => ({
    ...group,
    links: group.links.sort((a, b) => a.label.localeCompare(b.label)),
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
---

<nav class="site-nav" aria-label="Main navigation">
  <div class="container nav-inner">
    <a class="brand" href={baseUrl === '/' ? '/' : baseUrl}>Marekerk</a>

    <div class="nav-groups">
      {navItems.map((group) => (
        <div class="nav-group">
          <a class="nav-label" href={group.href} aria-label={group.label}>{group.label}</a>

          <div class="nav-subitems" aria-label={`${group.label} submenu`}>
            {group.links.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</nav>
