---
import Lockup from './Lockup.astro';
import { href } from '../lib/url';

export type NavKey = 'home' | 'services' | 'congregation' | 'building' | 'giving' | 'new';

interface Props {
  /** Active page in the main menu (aria-current="page"). Empty = none (e.g. 404). */
  current?: NavKey;
}

const { current } = Astro.props;

const items: { key: NavKey; label: string; path: string; button?: boolean }[] = [
  { key: 'home', label: 'Welkom', path: '/' },
  { key: 'services', label: 'Kerkdiensten', path: '/kerkdiensten/' },
  { key: 'congregation', label: 'Onze gemeente', path: '/onze-gemeente/' },
  { key: 'building', label: 'Gebouw', path: '/gebouw/' },
  { key: 'giving', label: 'Geven', path: '/geven/' },
  { key: 'new', label: 'Ik ben nieuw', path: '/ik-ben-nieuw/', button: true },
];
---
<header class="site-header">
  <div class="site-header-inner">
    <a href={href('/')} aria-label="Marekerk gemeente, naar de homepage" class="site-header-brand"><Lockup /></a>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="hoofdmenu"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>Menu</button>
    <nav id="hoofdmenu" aria-label="Hoofdmenu" class="nav-list">
      {items.map((item) => (
        <a
          href={href(item.path)}
          class={item.button ? 'btn btn-primary' : undefined}
          aria-current={item.key === current ? 'page' : undefined}
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('hoofdmenu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      menu.classList.toggle('open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!menu.classList.contains('open')));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('open')) {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
