---
/**
 * Agenda list (home and Kerkdiensten). Static: heading, skeleton, templates and subscribe line.
 * The agenda runtime replaces the content of [data-agenda-slot="body"] in the container
 * [data-agenda="list"] with either a <ul class="agenda-list"> of "row" clones, or "empty"/"error":
 *
 *   data-template="row"     <li> with [data-field="day"], [data-field="month"], [data-field="title"],
 *                           [data-field="subtitle"], [data-field="time"]
 *   data-template="empty"   empty state
 *   data-template="default" only the fixed service times (no feed URL configured)
 *   data-template="error"   error state with a [data-action="retry"] button
 *
 * Settings are data attributes on the container: data-limit, data-weeks.
 * Without JS: no skeleton (html:not(.js)), but the empty state from <noscript>.
 * While loading: aria-busy="true" on the body; the runtime removes it. The body is an
 * aria-live region and gets focus after a successful "Probeer opnieuw" (tabindex="-1").
 * States: design/Agenda-staten.dc.html, sections 2 and 3.
 */
import { AGENDA_EXTERNAL_URL, AGENDA_WEBCAL_URL } from '../lib/links';

interface Props {
  /** Heading above the list. */
  heading?: string;
  /** id of the h2 (for aria-labelledby). */
  headingId?: string;
  /** Heading size: 32 (home) or 40 (Kerkdiensten). */
  headingSize?: 32 | 40;
  /** Maximum number of items (home: 4). */
  limit?: number;
  /** Number of skeleton rows while loading (default `limit`, otherwise 3; Kerkdiensten: 6). */
  skeletonRows?: number;
  /** Period in weeks (Kerkdiensten: 6). */
  weeks?: number;
  /** "Hele agenda" link on the right of the heading. Without: "Diensten en activiteiten". */
  moreHref?: string;
  /** Show the subscribe line below the list. */
  subscribe?: boolean;
  /** id on the subscribe link (Kerkdiensten: "ics"). */
  subscribeId?: string;
}

const {
  heading = 'Agenda',
  headingId = 'agenda',
  headingSize = 32,
  limit,
  skeletonRows = limit ?? 3,
  weeks,
  moreHref,
  subscribe = true,
  subscribeId,
} = Astro.props;

// Widths from the design, so the skeleton doesn't look like one block
const widths = [
  ['55%', '35%'],
  ['40%', '50%'],
  ['60%', '30%'],
];
---
<div class="agenda" data-agenda="list" data-limit={limit} data-weeks={weeks}>
  <div class:list={['agenda-head', { 'agenda-head-lg': headingSize === 40 }]}>
    <h2 id={headingId}>{heading}</h2>
    {moreHref
      ? <a href={moreHref} style="font-weight: 700; white-space: nowrap">Hele agenda</a>
      : <span style="font-size: 14px; color: #4A5866">Diensten en activiteiten</span>}
  </div>

  <div class="js-only" data-agenda-slot="body" aria-busy="true" aria-live="polite" tabindex="-1">
  <ul class="agenda-list">
    {Array.from({ length: skeletonRows }, (_, i) => {
      const [w1, w2] = widths[i % widths.length];
      return (
        <li class="agenda-row" aria-hidden="true">
          <span class="oct oct-56 sk"></span>
          <span class="sk-lines"><span class="sk" style={`height: 16px; width: ${w1}`}></span><span class="sk" style={`height: 12px; width: ${w2}`}></span></span>
          <span class="sk" style="height: 16px; width: 44px"></span>
        </li>
      );
    })}
  </ul>
  </div>
  <noscript>
    <div class="agenda-message"><strong>Er staat nu niets in de agenda.</strong><span>Elke zondag zijn er diensten om 10.00 en 17.00.</span></div>
  </noscript>

  <template data-template="row">
    <li class="agenda-row"><span class="oct oct-56 oct-navy oct-date"><strong data-field="day">[DD]</strong><span data-field="month">[mnd]</span></span><span><strong data-field="title"></strong><br><span class="agenda-sub" data-field="subtitle"></span></span><strong data-field="time"></strong></li>
  </template>

  <template data-template="empty">
    <div class="agenda-message"><strong>Er staat nu niets in de agenda.</strong><span>Elke zondag zijn er diensten om 10.00 en 17.00.</span></div>
  </template>

  <template data-template="default">
    <div class="agenda-message"><span>Elke zondag zijn er diensten om 10.00 en 17.00.</span></div>
  </template>

  <template data-template="error">
    <div class="agenda-message"><strong>De agenda kon niet worden geladen.</strong><span>Elke zondag zijn er diensten om 10.00 en 17.00.</span><div class="agenda-message-actions"><button type="button" class="btn btn-outline" data-action="retry">Probeer opnieuw</button><a href={AGENDA_EXTERNAL_URL}>Open de agenda</a></div></div>
  </template>

  {subscribe && (
    <div class="agenda-subscribe">
      <a id={subscribeId} href={AGENDA_WEBCAL_URL}><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>Zet de agenda in je eigen agenda-app</a>
      <span>Diensten en activiteiten uit de kerkelijke agenda</span>
    </div>
  )}
</div>

<script>
  // Agenda runtime (ICS in the browser); Astro bundles and deduplicates this script.
  import '../scripts/agenda.ts';
</script>
