---
/**
 * Tijdenstrook (Welkom), variant A uit design/Main.dc.html: gouden achthoek-datum,
 * "Zondag"-lockup, hairline, tijden 40 px met de dienst in Light Italic eronder en
 * een witte omlijnde knop. Rendert statisch de basisstaat ("Elke zondag", zonder datum);
 * de agenda-runtime vervangt de inhoud van [data-agenda-slot="content"] door een kloon
 * van een template:
 *
 *   data-template="geladen"  [data-field="dag"], [data-field="maand"], [data-field="datum"]
 *                            + container [data-agenda-slot="diensten"] die gevuld wordt met
 *                            klonen van data-template="dienst" ([data-field="tijd"],
 *                            [data-field="omschrijving"])
 *   data-template="live"     [data-field="tijd"], [data-field="omschrijving"]
 *
 * Bij een fout blijft de basisstaat staan (geen foutmelding op Welkom).
 * Staten: design/Agenda-staten.dc.html, sectie 1 (in de vorm van variant A).
 */
import { href } from '../lib/url';
import { YOUTUBE_URL } from '../lib/links';

const liveHref = href('/kerkdiensten/#live');
---
<section aria-label="Eerstvolgende zondag" class="strook" data-agenda="strip">
  <div class="strook-inner" data-agenda-slot="content">
    <span class="strook-dag"><span class="strook-dag-naam"><strong>Elke zondag</strong></span></span>
    <span class="strook-lijn" aria-hidden="true"></span>
    <span class="strook-dienst"><strong>10.00</strong><span>Morgendienst</span></span>
    <span class="strook-dienst"><strong>17.00</strong><span>Middagdienst</span></span>
    <a href={liveHref} class="btn btn-wit strook-knop">Kijk of luister live mee</a>
  </div>

  <template data-template="geladen">
    <span class="strook-dag"><span aria-hidden="true" class="oct oct-56 oct-goud oct-date"><strong data-field="dag">[DD]</strong><span data-field="maand">[mnd]</span></span><span class="strook-dag-naam"><strong>Zondag</strong><span data-field="datum">[DD maand]</span></span></span>
    <span class="strook-lijn" aria-hidden="true"></span>
    <span data-agenda-slot="diensten" style="display: contents"></span>
    <a href={liveHref} class="btn btn-wit strook-knop">Kijk of luister live mee</a>
  </template>

  <template data-template="dienst">
    <span class="strook-dienst"><strong data-field="tijd">10.00</strong><span data-field="omschrijving">Morgendienst · Ds. [naam]</span></span>
  </template>

  <template data-template="live">
    <span class="strook-dag"><span class="label label-goud strook-live"><span aria-hidden="true" class="oct oct-10 oct-goud"></span>Nu live</span></span>
    <span class="strook-lijn" aria-hidden="true"></span>
    <span class="strook-dienst"><strong data-field="tijd">10.00</strong><span data-field="omschrijving">Morgendienst · Ds. [naam]</span></span>
    <a href={YOUTUBE_URL} class="btn btn-goud strook-knop">Kijk live mee</a>
  </template>
</section>

<script>
  // Agenda-runtime (ICS in de browser); Astro bundelt en dedupliceert dit script.
  import '../scripts/agenda.ts';
</script>
