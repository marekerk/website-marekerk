---
/**
 * Service bar (home), variant A from design/Main.dc.html: gold octagon date,
 * "Zondag" lockup, hairline, 40 px times with the service in Light Italic below and
 * a white outlined button. Renders the base state statically ("Elke zondag", without a date);
 * the agenda runtime replaces the content of [data-agenda-slot="content"] with a clone
 * of a template:
 *
 *   data-template="loaded"   [data-field="day"], [data-field="month"], [data-field="date"]
 *                            + container [data-agenda-slot="services"] which is filled with
 *                            clones of data-template="service" ([data-field="time"],
 *                            [data-field="description"])
 *   data-template="live"     [data-field="time"], [data-field="description"]
 *
 * On an error the base state stays (no error message on the home page).
 * States: design/Agenda-staten.dc.html, section 1 (in the form of variant A).
 */
import { href } from '../lib/url';
import { YOUTUBE_URL } from '../lib/links';

const liveHref = href('/kerkdiensten/#live');
---
<section aria-label="Eerstvolgende zondag" class="service-bar" data-agenda="strip">
  <div class="service-bar-inner" data-agenda-slot="content">
    <span class="service-bar-day"><span class="service-bar-day-name"><strong>Elke zondag</strong></span></span>
    <span class="service-bar-rule" aria-hidden="true"></span>
    <span class="service-bar-service"><strong>10.00</strong><span>Morgendienst</span></span>
    <span class="service-bar-service"><strong>17.00</strong><span>Middagdienst</span></span>
    <a href={liveHref} class="btn btn-white service-bar-button">Kijk of luister live mee</a>
  </div>

  <template data-template="loaded">
    <span class="service-bar-day"><span aria-hidden="true" class="oct oct-56 oct-gold oct-date"><strong data-field="day">[DD]</strong><span data-field="month">[mnd]</span></span><span class="service-bar-day-name"><strong>Zondag</strong><span data-field="date">[DD maand]</span></span></span>
    <span class="service-bar-rule" aria-hidden="true"></span>
    <span data-agenda-slot="services" style="display: contents"></span>
    <a href={liveHref} class="btn btn-white service-bar-button">Kijk of luister live mee</a>
  </template>

  <template data-template="service">
    <span class="service-bar-service"><strong data-field="time">10.00</strong><span data-field="description">Morgendienst · Ds. [naam]</span></span>
  </template>

  <template data-template="live">
    <span class="service-bar-day"><span class="label label-gold service-bar-live"><span aria-hidden="true" class="oct oct-10 oct-gold"></span>Nu live</span></span>
    <span class="service-bar-rule" aria-hidden="true"></span>
    <span class="service-bar-service"><strong data-field="time">10.00</strong><span data-field="description">Morgendienst · Ds. [naam]</span></span>
    <a href={YOUTUBE_URL} class="btn btn-gold service-bar-button">Kijk live mee</a>
  </template>
</section>

<script>
  // Agenda runtime (ICS in the browser); Astro bundles and deduplicates this script.
  import '../scripts/agenda.ts';
</script>
