---
/**
 * Patroon uit het gebouw, goud op 45 % en deels uit beeld. Eén patroon per pagina,
 * alleen op een navy vlak. De ouder heeft `position: relative; overflow: hidden`,
 * de inhoud erboven `position: relative`. Maten: design/DL-Patronen.dc.html.
 *
 * <Patroon />                          kroonluchter, hoek (Kerkdiensten, Ik ben nieuw)
 * <Patroon stand="hoek-ver" />         kroonluchter, 100 px verder uit beeld (tekstkolom rechts)
 * <Patroon stand="aangesneden" />      kroonluchter, groot (Welkom, geloof-vlak)
 * <Patroon patroon="plafond" />        koepelplafond, aangesneden (Gebouw)
 *
 * Mobiel (≤ 760 px) op 60 % van de maat (global.css).
 */
import Kroonluchter from '../assets/kroonluchter.svg';
import Plafond from '../assets/plafond-ruim.svg';

interface Props {
  patroon?: 'kroonluchter' | 'plafond';
  /** Alleen voor de kroonluchter; het plafond is altijd aangesneden. */
  stand?: 'hoek' | 'hoek-ver' | 'aangesneden';
}

const { patroon = 'kroonluchter', stand = 'hoek' } = Astro.props;
const Svg = patroon === 'plafond' ? Plafond : Kroonluchter;
const variant = patroon === 'plafond' ? 'plafond' : `kroon-${stand}`;
---
<Svg class={`patroon patroon-${variant}`} aria-hidden="true" />
