---
/**
 * Datum in achthoek 56: dag + maand.
 * <OctDate day="19" month="okt" />
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
  day: string | number;
  month: string;
  tone?: 'navy' | 'goud' | 'wit';
}

const { day, month, tone = 'navy', class: className, ...rest } = Astro.props;
---
<span class:list={['oct', 'oct-56', `oct-${tone}`, 'oct-date', className]} {...rest}><strong>{day}</strong><span>{month}</span></span>
