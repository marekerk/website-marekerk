---
/**
 * Numbered section heading: octagon 32 + h2 (40px), as on Gemeente/Gebouw.
 *
 * <SectionHead number={1} id="missie-kop">Missie en visie</SectionHead>
 * <SectionHead number={3} id="bakkerij-kop" tone="gold">…</SectionHead>   (on navy)
 * <SectionHead number={4} id="activiteiten-kop" rule>…</SectionHead>      (with a rule above)
 *
 * `id` goes on the h2 (for aria-labelledby on the <section>).
 */
interface Props {
  number: number | string;
  id: string;
  tone?: 'navy' | 'gold';
  /** 1px navy rule above + 20px space (when the heading itself opens the section). */
  rule?: boolean;
}

const { number, id, tone = 'navy', rule = false } = Astro.props;
---
<div class:list={['section-head', { 'section-head-rule': rule }]}>
  <span class:list={['oct', 'oct-32', `oct-${tone}`]}>{number}</span>
  <h2 id={id}><slot /></h2>
</div>
