---
/**
 * Brand as a lockup: emblem (the dome) + "Marekerk" Bold with "gemeente" Light Italic
 * below it, as live text. Never the logo as an image (design language v4).
 *
 * <Lockup />                 header: 46 px, 24/17 (mobile 40 px, 20/15)
 * <Lockup size="footer" />   footer: 44 px, 22/16, white
 *
 * Colour via `color` on the parent (the emblem fills with currentColor).
 */
import Emblem from '../assets/emblem.svg';

interface Props {
  size?: 'header' | 'footer';
}

const { size = 'header' } = Astro.props;
---
<span class:list={['lockup', `lockup-${size}`]}>
  <Emblem class="lockup-mark" aria-hidden="true" />
  <span class="lockup-name"><strong>Marekerk</strong><span>gemeente</span></span>
</span>
