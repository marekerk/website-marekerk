---
import '../styles/global.css';
import Header, { type NavKey } from '../components/Header.astro';
import Footer, { type PhotoKey } from '../components/Footer.astro';
import { href } from '../lib/url';

interface Props {
  /** Paginatitel zonder sitenaam; wordt "<title> – Marekerk". */
  title: string;
  description?: string;
  /** Actief item in het hoofdmenu. */
  current?: NavKey;
  /** Foto's op deze pagina voor de credits-regel in de footer (sleutels uit credits.json). */
  photos?: PhotoKey[];
}

const { title, description, current, photos } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script is:inline>document.documentElement.classList.add('js')</script>
    <title>{`${title} – Marekerk`}</title>
    {description && <meta name="description" content={description}>}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')}>
  </head>
  <body>
    <a href="#inhoud" class="skip">Direct naar de inhoud</a>
    <Header current={current} />
    <main id="inhoud">
      <slot />
    </main>
    <Footer photos={photos} />
  </body>
</html>
