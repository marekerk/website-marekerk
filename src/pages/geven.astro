---
import Base from '../layouts/Base.astro';
import Kroonluchter from '../components/Kroonluchter.astro';
import { href } from '../lib/url';
import { CONTACT } from '../lib/links';
---
<Base title="Geven en contact" current="geven">
  <section aria-labelledby="titel" class="container section" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: start">
    <div style="display: flex; flex-direction: column; gap: 20px">
      <nav aria-label="Kruimelpad" style="font-size: 14px; color: #4A5866"><a href={href('/')} style="color: #4A5866">Welkom</a> <span aria-hidden="true">/</span> Geven</nav>
      <h1 id="titel" style="margin: 0; font-size: clamp(48px, 6vw, 72px); font-weight: 700; letter-spacing: -0.03em; line-height: 0.95">Geven</h1>
      <p style="margin: 0; font-size: 20px; line-height: 1.5; color: #1A2733; max-width: 28em">[Tekst over geven volgt: collecte, kerkbalans en rekeningnummer]</p>
    </div>
    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(180px, auto); gap: 8px">
      <div style="background: #E6EBF0; padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px"><strong style="font-size: 22px; line-height: 1.15">Collecte</strong><span style="font-size: 15px; color: #1A2733">[Tekst volgt]</span></div>
      <div style="background: #FFFFFF; border: 1px solid #D9DEE3; padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px"><strong style="font-size: 22px; line-height: 1.15">Kerkbalans</strong><span style="font-size: 15px; color: #1A2733">[Tekst volgt]</span></div>
      <div style="grid-column: span 2; background: #09283F; color: #FFFFFF; padding: 24px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px"><span class="label label-goud">Rekeningnummer</span><strong style="font-size: 26px; line-height: 1.15">[IBAN]</strong><span style="font-size: 15px; color: #DCE6EF">[t.n.v. en omschrijving]</span></div>
    </div>
  </section>

  <section aria-labelledby="contact" style="margin-top: clamp(48px, 7vw, 96px); background: #09283F; color: #FFFFFF; position: relative; overflow: hidden">
    <Kroonluchter variant="hoek" ver />
    <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) clamp(20px, 4vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px 48px">
      <div style="display: flex; flex-direction: column; gap: 10px">
        {/* scroll-margin: bij /geven/#contact (footer) het navy vlak vanaf de bovenkant tonen */}
        <h2 id="contact" class="label label-goud" style="margin: 0; scroll-margin-top: clamp(56px, 8vw, 96px)">Contact</h2>
        <p style="margin: 0; font-size: clamp(26px, 3vw, 36px); font-weight: 700; line-height: 1.1; letter-spacing: -0.02em">Neem gerust contact op</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 4px"><strong>{CONTACT.naam}</strong><span style="color: #DCE6EF">predikant</span><a href={`mailto:${CONTACT.email}`} class="link-licht">{CONTACT.email}</a><a href={CONTACT.telefoonHref} class="link-licht">{CONTACT.telefoon}</a></div>
      <div style="display: flex; flex-direction: column; gap: 4px"><strong>Bijbelkringen</strong><span style="color: #DCE6EF">Paul en Janneke van Kruistum</span><a href="tel:0610904845" class="link-licht">06-10904845</a><a href="mailto:bijbelkringenmarekerk@gmail.com" class="link-licht">bijbelkringenmarekerk@gmail.com</a></div>
      <div style="display: flex; flex-direction: column; gap: 4px"><strong>Adres</strong><span style="color: #DCE6EF">[Adres], Leiden</span><span style="color: #DCE6EF">Marehuis: hoofdingang op 100 meter van de kerk</span><a href="#route" class="link-licht">Route</a></div>
    </div>
  </section>

  <section aria-labelledby="open" class="container section section-end" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px 48px; border-top: 1px solid #09283F">
    <div style="display: flex; flex-direction: column; gap: 6px"><h2 id="open" class="label" style="margin: 0; scroll-margin-top: clamp(48px, 7vw, 96px)">Kerk open</h2><strong style="font-size: 32px; letter-spacing: -0.02em; line-height: 1.1">Zaterdag 14.00–16.00</strong><span style="color: #1A2733">De kerk is meestal open op zaterdag van 14.00 tot 16.00 uur.</span></div>
    <div style="display: flex; flex-direction: column; gap: 6px"><span class="label">Zondag</span><strong style="font-size: 32px; letter-spacing: -0.02em; line-height: 1.1">10.00 – ca. 12.15</strong><span style="color: #1A2733">Inclusief koffie drinken na de dienst.</span></div>
    <div style="display: flex; flex-direction: column; gap: 6px"><span class="label">Zondag</span><strong style="font-size: 32px; letter-spacing: -0.02em; line-height: 1.1">17.00 – 18.30</strong><span style="color: #1A2733">Middagdienst.</span></div>
  </section>
</Base>
