---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Subnav from '../components/Subnav.astro';
import SectionHead from '../components/SectionHead.astro';
import Pattern from '../components/Pattern.astro';
import Prose from '../components/Prose.astro';
import { href } from '../lib/url';
import { block } from '../lib/content';
import facade from '../assets/photos/facade.jpg';
import organPhoto from '../assets/photos/organ.jpg';
import domeCeiling from '../assets/photos/dome-ceiling.jpg';
import domeExterior from '../assets/photos/dome-exterior.jpg';

const halfWidths = [480, 720, 960, 1280];
const halfSizes = '(min-width: 1000px) 556px, 100vw';

const hero = await block('gebouw/hero');
const history = await block('gebouw/geschiedenis');
const organ = await block('gebouw/orgel');
const art = await block('gebouw/kunst');
const visit = await block('gebouw/bezoeken');
const rent = await block('gebouw/huren');

// Highlighted (navy) module per list, as in the design
const navyYear = 1;
const navyTime = 0;
---
<Base
  title={hero.data.metaTitle ?? hero.data.title!}
  description={hero.data.description}
  current="building"
  photos={['facade', 'organ', 'dome-ceiling', 'dome-exterior']}
>
  <section aria-labelledby="titel" class="container section" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: end">
    <div style="display: flex; flex-direction: column; gap: 20px">
      <nav aria-label="Kruimelpad" style="font-size: 14px; color: #4A5866"><a href={href('/')} style="color: #4A5866">Welkom</a> <span aria-hidden="true">/</span> Gebouw</nav>
      <h1 id="titel" class="h1">{hero.data.title}</h1>
      <Prose block={hero} size={20} lineHeight={1.5} measure="28em" />
    </div>
    <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px">
      <Image src={facade} width={1280} widths={halfWidths} sizes={halfSizes} loading="eager" fetchpriority="high" alt="De achtkantige gevel van de Marekerk met koepel en lantaarn" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 30%; display: block" />
      <figcaption style="font-size: 14px; color: #4A5866">{hero.data.caption}</figcaption>
    </figure>
  </section>

  <Subnav items={[
    { href: '#geschiedenis', label: 'Geschiedenis' },
    { href: '#orgel', label: 'Orgel' },
    { href: '#kunst', label: 'Kunst in de kerk' },
    { href: '#bezoeken', label: 'Bezoeken' },
    { href: '#huren', label: 'Huren' },
  ]} />

  <section id="geschiedenis" aria-labelledby="geschiedenis-kop" class="container" style="padding-top: clamp(40px, 6vw, 72px); display: flex; flex-direction: column; gap: 24px">
    <SectionHead number={1} id="geschiedenis-kop" rule>{history.data.title}</SectionHead>
    <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); grid-auto-rows: minmax(200px, auto); gap: 8px">
      {history.data.items.map((year, i) => i === navyYear ? (
        <li style="background: #09283F; color: #FFFFFF; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px"><strong style="font-size: 48px; letter-spacing: -0.03em; line-height: 0.9; color: #C9A13B">{year.title}</strong><span style="font-size: 15px; color: #DCE6EF">{year.text}</span></li>
      ) : (
        <li style="background: #E6EBF0; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px"><strong style="font-size: 48px; letter-spacing: -0.03em; line-height: 0.9">{year.title}</strong><span style="font-size: 15px; color: #1A2733">{year.text}</span></li>
      ))}
    </ol>
  </section>

  <section id="orgel" aria-labelledby="orgel-kop" style="margin-top: clamp(48px, 7vw, 96px); background: #09283F; color: #FFFFFF; position: relative; overflow: hidden">
    <Pattern pattern="ceiling" />
    <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) clamp(20px, 4vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 32px 48px; align-items: center">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <SectionHead number={2} id="orgel-kop" tone="gold">{organ.data.title}</SectionHead>
        <Prose block={organ} tone="light" />
        {organ.data.buttons.map((b) => <a href={href(b.link)} class="link-light" style="align-self: flex-start; font-weight: 700; min-height: 44px; display: inline-flex; align-items: center">{b.text}</a>)}
      </div>
      <Image src={organPhoto} width={1280} widths={halfWidths} sizes={halfSizes} alt="Het Garrelsorgel" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 25%; display: block" />
    </div>
  </section>

  <section id="kunst" aria-labelledby="kunst-kop" class="container section" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: start">
    <div style="display: flex; flex-direction: column; gap: 14px; border-top: 1px solid #09283F; padding-top: 20px">
      <SectionHead number={3} id="kunst-kop">{art.data.title}</SectionHead>
      <Prose block={art} />
      {art.data.buttons.map((b) => <a href={href(b.link)} style="align-self: flex-start; font-weight: 700; min-height: 44px; display: inline-flex; align-items: center">{b.text}</a>)}
    </div>
    <Image src={domeCeiling} width={1280} widths={halfWidths} sizes={halfSizes} alt="Het achtkantige koepelplafond met de rozet" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 30%; display: block" />
  </section>

  <section id="bezoeken" aria-labelledby="bezoeken-kop" class="container section" style="display: flex; flex-direction: column; gap: 24px">
    <SectionHead number={4} id="bezoeken-kop" rule>{visit.data.title}</SectionHead>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); grid-auto-rows: minmax(170px, auto); gap: 8px">
      {visit.data.items.map((t, i) => (
        <div style={i === navyTime
          ? 'background: #09283F; color: #FFFFFF; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px'
          : 'background: #E6EBF0; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px'}>
          <span class:list={['label', { 'label-gold': i === navyTime }]}>{t.label}</span>
          <span><strong style="font-size: 36px; letter-spacing: -0.02em; line-height: 1; display: block">{t.title}</strong><span style={`font-size: 15px; color: ${i === navyTime ? '#DCE6EF' : '#1A2733'}`}>{t.text}</span></span>
        </div>
      ))}
    </div>
  </section>

  <section id="huren" aria-labelledby="huren-kop" class="container section section-end" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: start">
    <Image src={domeExterior} width={1280} widths={halfWidths} sizes={halfSizes} alt="De koepel van de Marekerk met lantaarn en klok" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block" />
    <div style="display: flex; flex-direction: column; gap: 14px; border-top: 1px solid #09283F; padding-top: 20px">
      <SectionHead number={5} id="huren-kop">{rent.data.title}</SectionHead>
      <Prose block={rent} />
      {rent.data.buttons.map((b) => <a href={href(b.link)} class="btn btn-primary" style="align-self: flex-start">{b.text}</a>)}
    </div>
  </section>
</Base>
