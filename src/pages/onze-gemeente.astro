---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Subnav from '../components/Subnav.astro';
import SectionHead from '../components/SectionHead.astro';
import Oct from '../components/Oct.astro';
import Pattern from '../components/Pattern.astro';
import Prose from '../components/Prose.astro';
import { href } from '../lib/url';
import { block, blocksIn } from '../lib/content';
import pulpit from '../assets/photos/pulpit.jpg';
import organ from '../assets/photos/organ.jpg';

const hero = await block('onze-gemeente/hero');
const mission = await block('onze-gemeente/missie');
const pgl = await block('onze-gemeente/pgl');
const bakery = await block('onze-gemeente/bakkerij');
const activities = await block('onze-gemeente/activiteiten');
const activityCards = await blocksIn('onze-gemeente/activiteiten');
const music = await block('onze-gemeente/muziek');
const musicCards = await blocksIn('onze-gemeente/muziek');
const celebrations = await block('onze-gemeente/vieringen');
const celebrationCards = await blocksIn('onze-gemeente/vieringen');

const halfWidths = [480, 720, 960, 1280];
const halfSizes = '(min-width: 1000px) 556px, 100vw';

// Module backgrounds, alternating as in the design
const lightCard = 'background: #FFFFFF; border: 1px solid #D9DEE3';
const tintCard = 'background: #E6EBF0';
---
<Base
  title={hero.data.metaTitle ?? hero.data.title!}
  description={hero.data.description}
  current="congregation"
  photos={['pulpit', 'organ']}
>
  <section aria-labelledby="titel" class="container section" style="display: flex; flex-direction: column; gap: 20px">
    <nav aria-label="Kruimelpad" style="font-size: 14px; color: #4A5866"><a href={href('/')} style="color: #4A5866">Welkom</a> <span aria-hidden="true">/</span> Onze gemeente</nav>
    <h1 id="titel" class="h1">{hero.data.title}</h1>
    <Prose block={hero} size={20} lineHeight={1.5} measure="32em" />
  </section>

  <Subnav items={[
    { href: '#missie', label: 'Missie en visie' },
    { href: '#pgl', label: 'Protestantse gemeente Leiden' },
    { href: '#bakkerij', label: 'De Bakkerij' },
    { href: '#activiteiten', label: 'Activiteiten' },
    { href: '#muziek', label: 'Muziek' },
    { href: '#vieringen', label: 'Bijzondere vieringen' },
  ]} />

  <section id="missie" aria-labelledby="missie-kop" class="container" style="padding-top: clamp(40px, 6vw, 72px); display: flex; flex-direction: column; gap: 32px">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: start">
      <div style="display: flex; flex-direction: column; gap: 14px; border-top: 1px solid #09283F; padding-top: 20px">
        <SectionHead number={1} id="missie-kop">{mission.data.title}</SectionHead>
        <Prose block={mission} />
      </div>
      <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px">
        <Image src={pulpit} width={1280} widths={halfWidths} sizes={halfSizes} alt="De preekstoel uit 1649 met de opengeslagen Bijbel" style="width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block" />
        <figcaption style="font-size: 14px; color: #4A5866">{mission.data.caption}</figcaption>
      </figure>
    </div>
    <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); grid-auto-rows: minmax(180px, auto); gap: 8px">
      {mission.data.items.map((pillar, i) => (
        <li style={i % 2 === 1
          ? 'background: #09283F; color: #FFFFFF; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px'
          : 'background: #E6EBF0; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 12px'}>
          <Oct size={24} tone={i % 2 === 1 ? 'gold' : 'navy'}>{i + 1}</Oct>
          <strong style="font-size: 20px; line-height: 1.2">{pillar.text}</strong>
        </li>
      ))}
    </ol>
  </section>

  <section id="pgl" aria-labelledby="pgl-kop" class="container section" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: start">
    <div style="display: flex; flex-direction: column; gap: 14px; border-top: 1px solid #09283F; padding-top: 20px">
      <SectionHead number={2} id="pgl-kop">{pgl.data.title}</SectionHead>
      <Prose block={pgl} />
    </div>
    <div style="display: flex; flex-direction: column; gap: 12px; border-top: 1px solid #09283F; padding-top: 20px">
      <span class="label">{pgl.data.label}</span>
      <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">
        {pgl.data.items.map((community) => (
          <li style="display: flex; gap: 12px; align-items: center; padding: 12px 0; border-bottom: 1px solid #D9DEE3"><Oct size={10} />{community.text}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="bakkerij" aria-labelledby="bakkerij-kop" style="margin-top: clamp(48px, 7vw, 96px); background: #09283F; color: #FFFFFF; position: relative; overflow: hidden">
    <Pattern position="corner-far" />
    <div style="position: relative; max-width: 1200px; margin: 0 auto; padding: clamp(56px, 8vw, 96px) clamp(20px, 4vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 32px 48px; align-items: start">
      <div style="display: flex; flex-direction: column; gap: 14px">
        <SectionHead number={3} id="bakkerij-kop" tone="gold">{bakery.data.title}</SectionHead>
        <p style="margin: 0; color: #DCE6EF">{bakery.data.intro}</p>
      </div>
      <div style="display: flex; flex-direction: column; gap: 14px">
        <Prose block={bakery} tone="light" />
        {bakery.data.buttons.map((b) => <a href={href(b.link)} class="link-light" style="align-self: flex-start; font-weight: 700; min-height: 44px; display: inline-flex; align-items: center">{b.text}</a>)}
      </div>
    </div>
  </section>

  <section id="activiteiten" aria-labelledby="activiteiten-kop" class="container section" style="display: flex; flex-direction: column; gap: 24px">
    <SectionHead number={4} id="activiteiten-kop" rule>{activities.data.title}</SectionHead>
    {/* Wide cards go in their own row, so auto-fit can collapse the empty tracks of the normal ones */}
    <div style="display: flex; flex-direction: column; gap: 8px">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 8px">
        {activityCards.map((card, i) => !card.data.wide && (
          <div style={`${i % 2 === 1 ? tintCard : lightCard}; padding: 24px; display: flex; flex-direction: column; gap: 8px`}><strong style="font-size: 22px; line-height: 1.15">{card.data.title}</strong><Prose block={card} size={15} /></div>
        ))}
      </div>
      {activityCards.map((card, i) => card.data.wide && (
        <div style={`${i % 2 === 1 ? tintCard : lightCard}; padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 16px 32px`}><strong style="font-size: 22px; line-height: 1.15; grid-column: 1 / -1">{card.data.title}</strong><Prose block={card} size={15} /></div>
      ))}
    </div>
  </section>

  <section id="muziek" aria-labelledby="muziek-kop" class="container section" style="display: flex; flex-direction: column; gap: 24px">
    <div style="display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #09283F; padding-top: 20px">
      <SectionHead number={5} id="muziek-kop">{music.data.title}</SectionHead>
      <Prose block={music} measure="34em" />
    </div>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); grid-auto-rows: minmax(240px, auto); gap: 8px">
      <div style="position: relative; overflow: hidden; min-height: 240px">
        <Image src={organ} width={800} widths={[400, 600, 800]} sizes="(min-width: 1000px) 280px, 100vw" alt="Het Garrelsorgel" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 25%; display: block" />
      </div>
      {musicCards.map((card, i) => card.data.buttons.length ? (
        <div style="background: #09283F; color: #FFFFFF; padding: 24px; display: flex; flex-direction: column; justify-content: space-between; gap: 8px"><div style="display: flex; flex-direction: column"><strong style="font-size: 22px; line-height: 1.15">{card.data.title}</strong><Prose block={card} tone="light" size={15} /></div>{card.data.buttons.map((b) => <a href={href(b.link)} class="link-light" style="font-weight: 700; min-height: 44px; display: inline-flex; align-items: center">{b.text}</a>)}</div>
      ) : (
        <div style={`${i % 2 === 1 ? tintCard : lightCard}; padding: 24px; display: flex; flex-direction: column; gap: 8px`}><strong style="font-size: 22px; line-height: 1.15">{card.data.title}</strong><Prose block={card} size={15} /></div>
      ))}
    </div>
  </section>

  <section id="vieringen" aria-labelledby="vieringen-kop" class="container section section-end" style="display: flex; flex-direction: column; gap: 24px">
    <SectionHead number={6} id="vieringen-kop" rule>{celebrations.data.title}</SectionHead>
    {/* Wide card in its own row, so auto-fit drops the empty column of the normal cards (as with Activiteiten) */}
    <div style="display: flex; flex-direction: column; gap: 8px">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 8px">
        {celebrationCards.map((card, i) => !card.data.wide && (
          <div style={`${i % 2 === 1 ? tintCard : lightCard}; padding: 24px; display: flex; flex-direction: column; gap: 8px`}><h3 style="margin: 0; font-size: 22px; line-height: 1.15">{card.data.title}</h3><Prose block={card} size={15} /></div>
        ))}
      </div>
      {celebrationCards.map((card) => card.data.wide && (
        /* Belijdenis doen: label, heading and first paragraph on the left; the rest and the button on the right */
        <div style="background: #E6EBF0; padding: clamp(24px, 4vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 24px 48px; align-items: start">
          <div style="display: flex; flex-direction: column; gap: 10px">
            {card.data.label && <span class="label">{card.data.label}</span>}
            <h3 style="margin: 0; font-size: 32px; line-height: 1.1; letter-spacing: -0.01em">{card.data.title}</h3>
            <Prose block={card} to={1} />
          </div>
          <div style="display: flex; flex-direction: column; gap: 14px; align-items: flex-start">
            <Prose block={card} from={1} />
            {card.data.buttons.map((b) => <a href={href(b.link)} class="btn btn-primary">{b.text}</a>)}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
