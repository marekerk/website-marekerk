---
import Base from '../layouts/Base.astro';
import Oct from '../components/Oct.astro';
import { href } from '../lib/url';

const links = [
  { path: '/kerkdiensten/', label: 'Kerkdiensten' },
  { path: '/onze-gemeente/', label: 'Onze gemeente' },
  { path: '/ik-ben-nieuw/', label: 'Ik ben nieuw' },
  { path: '/gebouw/', label: 'Gebouw' },
  { path: '/geven/#contact', label: 'Contact' },
];
---
<Base title="Pagina niet gevonden" photos={['preekstoel', 'orgel']}>
  <section aria-labelledby="titel" class="container section section-end" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; align-items: start">
    <div style="display: flex; flex-direction: column; gap: 20px">
      <span class="label">Fout 404</span>
      <h1 id="titel" style="margin: 0; font-size: clamp(48px, 6vw, 72px); font-weight: 700; letter-spacing: -0.03em; line-height: 0.95">Deze pagina bestaat niet</h1>
      <p style="margin: 0; font-size: 20px; line-height: 1.5; color: #1A2733; max-width: 28em">Het adres klopt niet of de pagina is verplaatst.</p>
      <a href={href('/')} class="btn btn-primary" style="align-self: flex-start">Naar Welkom</a>
    </div>
    <nav aria-label="Verder naar" style="border-top: 1px solid #09283F; padding-top: 8px">
      {links.map((link, i) => (
        <a href={href(link.path)} style="display: flex; align-items: center; gap: 14px; min-height: 56px; border-bottom: 1px solid #D9DEE3; text-decoration: none; font-weight: 700; font-size: 20px"><Oct size={24}>{i + 1}</Oct>{link.label}</a>
      ))}
    </nav>
  </section>
</Base>
