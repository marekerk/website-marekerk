---
import Base from '../layouts/Base.astro';
import Oct from '../components/Oct.astro';
import Prose from '../components/Prose.astro';
import { href } from '../lib/url';
import { block } from '../lib/content';

const page = await block('404/hero');
---
<Base title={page.data.metaTitle ?? page.data.title!} description={page.data.description} photos={['preekstoel', 'orgel']}>
  <section aria-labelledby="titel" class="container section section-end" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; align-items: start">
    <div style="display: flex; flex-direction: column; gap: 20px">
      <span class="label">{page.data.label}</span>
      <h1 id="titel" style="margin: 0; font-size: clamp(48px, 6vw, 72px); font-weight: 700; letter-spacing: -0.03em; line-height: 0.95">{page.data.title}</h1>
      <Prose block={page} size={20} lineHeight={1.5} measure="28em" />
      {page.data.buttons.map((b) => <a href={href(b.link)} class="btn btn-primary" style="align-self: flex-start">{b.text}</a>)}
    </div>
    <nav aria-label="Verder naar" style="border-top: 1px solid #09283F; padding-top: 8px">
      {page.data.items.map((item, i) => (
        <a href={href(item.link ?? '/')} style="display: flex; align-items: center; gap: 14px; min-height: 56px; border-bottom: 1px solid #D9DEE3; text-decoration: none; font-weight: 700; font-size: 20px"><Oct size={24}>{i + 1}</Oct>{item.title}</a>
      ))}
    </nav>
  </section>
</Base>
